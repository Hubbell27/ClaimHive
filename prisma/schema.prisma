// ClaimHive data model.
//
// Tenant tables (practice_id NOT NULL) are protected by PostgreSQL row-level
// security (see prisma/migrations/*_security/migration.sql): a query only sees
// rows for the practice set in the transaction via `app.practice_id`.
// Direct identifiers are stored only as AES-256-GCM ciphertext (*_enc columns)
// under a per-practice data key; see src/lib/crypto.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  biller
}

enum PlanType {
  PPO
  DHMO
  INDEMNITY
  MEDICAID
  MEDICARE_ADVANTAGE
  UNKNOWN // the source didn't say (e.g. an aging report without a plan column)
}

enum ClaimStatus {
  draft
  submitted
  paid
  partially_paid
  denied
}

enum AppealStatus {
  none
  drafted
  sent
  won
  lost
}

enum ImportKind {
  aging      // insurance aging report (CSV / Excel)
  era835     // X12 835 remittance
  claim837   // X12 837D dental claim
  eob_pdf    // EOB PDF
}

enum ImportStatus {
  mapping_needed
  queued
  processing
  needs_review
  done
  failed
}

enum ReviewStatus {
  open
  accepted
  dismissed
}

enum ResultKind {
  recovered // money won back after a denial (cash received)
  protected // a claim fixed before sending that was then paid (shown, never billed)
  reversed // the insurer took back money recorded as recovered (Phase 7; credited if it was billed)
}

// ---------------------------------------------------------------- identity

model User {
  id                 String       @id @default(uuid()) @db.Uuid
  email              String       @unique
  name               String
  passwordHash       String       @map("password_hash")
  isPlatformAdmin    Boolean      @default(false) @map("is_platform_admin")
  totpSecretEnc      Bytes?       @map("totp_secret_enc")
  totpEnabled        Boolean      @default(false) @map("totp_enabled")
  totpLastStep       BigInt?      @map("totp_last_step")
  failedLogins       Int          @default(0) @map("failed_logins")
  lockedUntil        DateTime?    @map("locked_until") @db.Timestamptz
  mustChangePassword Boolean      @default(true) @map("must_change_password")
  disabledAt         DateTime?    @map("disabled_at") @db.Timestamptz
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  lastLoginAt        DateTime?    @map("last_login_at") @db.Timestamptz
  memberships        Membership[]
  sessions           Session[]

  @@map("users")
}

model Practice {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  state          String       @db.Char(2) // US state; the only location detail ever pooled
  // Per-practice data-encryption key, wrapped by the master key (KMS in AWS).
  dataKeyWrapped Bytes        @map("data_key_wrapped")
  poolOptIn      Boolean      @default(false) @map("pool_opt_in")
  poolOptInAt    DateTime?    @map("pool_opt_in_at") @db.Timestamptz
  poolOptInBy    String?      @map("pool_opt_in_by") @db.Uuid
  // The owner's recorded choice at onboarding (yes or no), and which consent text they saw.
  poolDecidedAt  DateTime?    @map("pool_decided_at") @db.Timestamptz
  poolConsentVersion String?  @map("pool_consent_version")
  // The newest consent version the owner has been shown (so an update is asked about once).
  poolConsentOffered String?  @map("pool_consent_offered")
  // Random contributor token used in the pool instead of the practice id. Rotated on opt-out.
  poolToken      String?      @map("pool_token") @db.Uuid
  poolSyncedAt   DateTime?    @map("pool_synced_at") @db.Timestamptz
  poolShared     Int          @default(0) @map("pool_shared")   // claims currently in the pool
  poolSkipped    Int          @default(0) @map("pool_skipped")  // claims held back (e.g. unrecognized insurer)
  isSynthetic    Boolean      @default(false) @map("is_synthetic")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  // Letterhead for appeal letters (Phase 6): business details, merged locally, never sent to the AI.
  letterName     String?      @map("letter_name") // name as it should appear on letters (defaults to `name`)
  addressLine1   String?      @map("address_line1")
  addressLine2   String?      @map("address_line2")
  city           String?
  zip            String?      @db.VarChar(10)
  phone          String?      @db.VarChar(20)
  fax            String?      @db.VarChar(20)
  npi            String?      @db.VarChar(10) // billing (type 2) NPI
  taxId          String?      @map("tax_id") @db.VarChar(10)
  signerName     String?      @map("signer_name")
  signerTitle    String?      @map("signer_title")
  // Guided setup (Phase 8): optional steps the owner chose to skip, and when the 12-month report was first opened.
  setupSkipped   String[]     @default([]) @map("setup_skipped")
  reportViewedAt DateTime?    @map("report_viewed_at") @db.Timestamptz
  memberships    Membership[]
  billingRates   BillingRate[]

  @@map("practices")
}

model Membership {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  practiceId String   @map("practice_id") @db.Uuid
  role       Role
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@unique([userId, practiceId])
  @@map("memberships")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  // SHA-256 of the random cookie token; the token itself is never stored.
  tokenHash        String    @unique @map("token_hash")
  userId           String    @map("user_id") @db.Uuid
  mfaVerified      Boolean   @default(false) @map("mfa_verified")
  activePracticeId String?   @map("active_practice_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------- audit

// Append-only (DB trigger rejects UPDATE/DELETE/TRUNCATE). No PHI in details.
model AuditEvent {
  id           BigInt   @id @default(autoincrement())
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorEmail   String?  @map("actor_email")
  practiceId   String?  @map("practice_id") @db.Uuid
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  outcome      String   @default("success")
  ip           String?
  userAgent    String?  @map("user_agent")
  requestId    String?  @map("request_id")
  details      Json     @default("{}")

  @@index([practiceId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------- reference (global, no PHI)

model Payer {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @unique
  payerCode String  @unique @map("payer_code")
  isSynthetic Boolean @default(false) @map("is_synthetic")
  // Only verified insurers (from an X12 payer ID, or curated) are named in the pool, so a
  // mis-mapped spreadsheet column can never put a person's name into shared data.
  verified  Boolean @default(false)
  claims    Claim[]

  @@map("payers")
}

// ---------------------------------------------------------------- tenant data (PHI; RLS)

model Patient {
  id           String   @id @default(uuid()) @db.Uuid
  practiceId   String   @map("practice_id") @db.Uuid
  firstNameEnc Bytes    @map("first_name_enc")
  lastNameEnc  Bytes    @map("last_name_enc")
  dobEnc       Bytes?   @map("dob_enc") // remittances (835) don't carry a date of birth
  memberIdEnc  Bytes?   @map("member_id_enc")
  // Keyed hash of normalized last name + DOB for lookup without plaintext.
  lookupIndex  String?  @map("lookup_index")
  // Keyed hash of normalized member ID + last name (matching remittances).
  memberLookup String?  @map("member_lookup")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  claims       Claim[]

  @@index([practiceId, lookupIndex])
  @@index([practiceId, memberLookup])
  @@map("patients")
}

model Claim {
  id              String       @id @default(uuid()) @db.Uuid
  practiceId      String       @map("practice_id") @db.Uuid
  patientId       String       @map("patient_id") @db.Uuid
  payerId         String       @map("payer_id") @db.Uuid
  planType        PlanType     @map("plan_type")
  claimNumberEnc  Bytes?       @map("claim_number_enc")
  // Keyed hash of the practice's claim number (837 CLM01 = 835 CLP01) for matching.
  claimKey        String?      @map("claim_key")
  // Which kinds of files have contributed to this claim, e.g. ["claim837", "era835"].
  sources         String[]     @default([])
  serviceDate     DateTime     @map("service_date") @db.Date
  submittedAt     DateTime?    @map("submitted_at") @db.Date
  adjudicatedAt   DateTime?    @map("adjudicated_at") @db.Date
  status          ClaimStatus
  billedCents     Int          @map("billed_cents")
  paidCents       Int          @default(0) @map("paid_cents")
  // e.g. ["xray", "narrative", "perio_chart", "photo"]
  attachments     String[]     @default([])
  appealStatus    AppealStatus @default(none) @map("appeal_status")
  recoveredCents  Int          @default(0) @map("recovered_cents")
  // What the appeal included (Phase 4): attachments added and the kind of argument made.
  appealAttachments String[]   @default([]) @map("appeal_attachments")
  appealArgument  String?      @map("appeal_argument")
  appealSentAt    DateTime?    @map("appeal_sent_at") @db.Date
  // The ClaimHive rule whose suggested fix the office used for this appeal (tenant-only; for attribution).
  appealRuleKey   String?      @map("appeal_rule_key")
  // The ClaimHive-drafted letter that was sent for this appeal (Phase 6; attribution).
  appealLetterId  String?      @map("appeal_letter_id") @db.Uuid
  // Pre-submission check (Phase 5): the latest score, kept on the claim for lists.
  precheckedAt    DateTime?    @map("prechecked_at") @db.Timestamptz
  riskScore       Float?       @map("risk_score")      // chance at least one line is denied (0..1)
  atRiskCents     Int?         @map("at_risk_cents")   // expected dollars lost if sent as is
  isSynthetic     Boolean      @default(false) @map("is_synthetic")
  // Random id of this claim's de-identified copy in the pool (only this tenant row links them).
  poolRecordId    String?      @map("pool_record_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  payer           Payer        @relation(fields: [payerId], references: [id])
  lines           ClaimLine[]
  denials         Denial[]
  results         ResultEvent[]
  reviewItems     ReviewItem[]
  findings        CheckFinding[]
  letters         AppealLetter[]

  @@index([practiceId, claimKey])
  @@index([practiceId, updatedAt])
  @@index([practiceId, status])
  @@index([practiceId, serviceDate])
  @@map("claims")
}

model ClaimLine {
  id         String  @id @default(uuid()) @db.Uuid
  practiceId String  @map("practice_id") @db.Uuid
  claimId    String  @map("claim_id") @db.Uuid
  cdtCode    String  @map("cdt_code") @db.VarChar(5)
  tooth      String? @db.VarChar(3)
  surfaces   String? @db.VarChar(5)
  feeCents   Int     @map("fee_cents")
  paidCents  Int     @default(0) @map("paid_cents")
  claim      Claim   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  denials    Denial[]

  @@index([practiceId, cdtCode])
  @@map("claim_lines")
}

model Denial {
  id          String     @id @default(uuid()) @db.Uuid
  practiceId  String     @map("practice_id") @db.Uuid
  claimId     String     @map("claim_id") @db.Uuid
  claimLineId String?    @map("claim_line_id") @db.Uuid
  groupCode   String     @map("group_code") @db.VarChar(2) // CO, PR, OA, PI
  carc        String     @db.VarChar(5)
  rarc        String?    @db.VarChar(6)
  amountCents Int        @map("amount_cents")
  deniedAt    DateTime   @map("denied_at") @db.Date
  claim       Claim      @relation(fields: [claimId], references: [id], onDelete: Cascade)
  claimLine   ClaimLine? @relation(fields: [claimLineId], references: [id], onDelete: Cascade)

  @@index([practiceId, carc])
  @@map("denials")
}

// ---------------------------------------------------------------- ingestion (PHI; RLS)

model ImportBatch {
  id            String       @id @default(uuid()) @db.Uuid
  practiceId    String       @map("practice_id") @db.Uuid
  kind          ImportKind
  status        ImportStatus
  // File names often contain patient names, so they're encrypted too.
  fileNameEnc   Bytes        @map("file_name_enc")
  // Keyed hash of the file contents: refuses the same file twice.
  fileKey       String       @map("file_key")
  // Encrypted original, kept for re-processing and review; purged after 90 days.
  fileEnc       Bytes?       @map("file_enc")
  sizeBytes     Int          @map("size_bytes")
  // Column mapping (aging reports): target field -> source header. Headers only, no PHI.
  mapping       Json?
  detectedSystem String?     @map("detected_system")
  // "record" = files describing what already happened; "precheck" = claims about to be sent.
  purpose       String       @default("record")
  atRiskCents   Int          @default(0) @map("at_risk_cents")
  riskyClaims   Int          @default(0) @map("risky_claims")
  // Pre-send batches: which claims were checked (ids only), for the batch's results table.
  checkedClaimIds String[]   @default([]) @map("checked_claim_ids") @db.Uuid
  rowsTotal     Int          @default(0) @map("rows_total")
  claimsCreated Int          @default(0) @map("claims_created")
  claimsUpdated Int          @default(0) @map("claims_updated")
  rowsSkipped   Int          @default(0) @map("rows_skipped")
  reviewCount   Int          @default(0) @map("review_count")
  deniedCents   Int          @default(0) @map("denied_cents")
  paidCents     Int          @default(0) @map("paid_cents")
  // Short, PHI-free problem codes and row numbers only.
  problems      Json         @default("[]")
  createdBy     String       @map("created_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  finishedAt    DateTime?    @map("finished_at") @db.Timestamptz
  reviewItems   ReviewItem[]
  results       ResultEvent[]

  @@unique([practiceId, fileKey])
  @@index([practiceId, createdAt])
  @@map("import_batches")
}

// A saved column mapping, reused automatically when a report with the same headers is uploaded.
model ImportMapping {
  id              String   @id @default(uuid()) @db.Uuid
  practiceId      String   @map("practice_id") @db.Uuid
  headerSignature String   @map("header_signature")
  mapping         Json
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([practiceId, headerSignature])
  @@map("import_mappings")
}

// Something the importer wasn't sure about. A person confirms or corrects it before it counts.
model ReviewItem {
  id          String       @id @default(uuid()) @db.Uuid
  practiceId  String       @map("practice_id") @db.Uuid
  batchId     String       @map("batch_id") @db.Uuid
  claimId     String?      @map("claim_id") @db.Uuid
  status      ReviewStatus @default(open)
  // Encrypted JSON: the extracted claim and a confidence score per field.
  payloadEnc  Bytes        @map("payload_enc")
  // PHI-free: which fields are uncertain and why, e.g. ["paid_amount: two candidates"].
  flags       String[]     @default([])
  minConfidence Float      @map("min_confidence")
  resolvedBy  String?      @map("resolved_by") @db.Uuid
  resolvedAt  DateTime?    @map("resolved_at") @db.Timestamptz
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  batch       ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  claim       Claim?       @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([practiceId, status])
  @@map("review_items")
}

// The results ledger: every dollar recovered or protected, what did it, and the evidence.
// The results page, the monthly report and (Phase 7) contingency invoices all read from here.
model ResultEvent {
  id           String       @id @default(uuid()) @db.Uuid
  practiceId   String       @map("practice_id") @db.Uuid
  claimId      String       @map("claim_id") @db.Uuid
  kind         ResultKind
  amountCents  Int          @map("amount_cents")
  // True only when the money came through a ClaimHive-flagged fix or a ClaimHive appeal.
  // Only attributed, recovered money is billable.
  attributed   Boolean
  // Stable code for how it was won, e.g. "appeal_with_attachment", "attachment_added_before_sending".
  method       String
  // One plain-English sentence, PHI-free, e.g. "Appealed with the X-ray the insurer asked for (CARC 16 / N706)".
  explanation  String
  // PHI-free evidence: payer, codes, denial reason, rule id, and dates.
  evidence     Json         @default("{}")
  occurredAt   DateTime     @map("occurred_at") @db.Date
  sourceBatchId String?     @map("source_batch_id") @db.Uuid
  isSynthetic  Boolean      @default(false) @map("is_synthetic")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  claim        Claim        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  sourceBatch  ImportBatch? @relation(fields: [sourceBatchId], references: [id], onDelete: SetNull)

  // Distinguishes repeat events on one claim (a second partial payment, a later reversal):
  // the paid total after the event, e.g. "paid:40000". "" for one-off events.
  seqKey        String       @default("") @map("seq_key")
  statementLines StatementLine[]

  @@unique([claimId, kind, method, seqKey])
  @@index([practiceId, occurredAt])
  @@map("result_events")
}

// ---------------------------------------------------------------- pre-submission check (PHI-free text; RLS)

enum FindingStatus {
  open
  fixed_by_user    // the biller ticked "fixed"
  fixed_detected   // a later 837/835 showed the fix (e.g. the attachment was sent)
  dismissed        // the biller said it doesn't apply
}

// One thing the pre-submission check found on a claim, with the fix and the money at stake.
model CheckFinding {
  id           String        @id @default(uuid()) @db.Uuid
  practiceId   String        @map("practice_id") @db.Uuid
  claimId      String        @map("claim_id") @db.Uuid
  // pool_rule | missing_tooth | missing_surface | duplicate | timely_filing | frequency
  kind         String
  source       String        // "pool" (needs sharing) or "basic"
  ruleKey      String?       @map("rule_key")
  cdtCode      String        @map("cdt_code") @db.VarChar(5)
  // attachment | code | data | verify
  fixType      String        @map("fix_type")
  attachment   String?
  title        String
  detail       String        // plain English, with the evidence
  fix          String
  probability  Float
  atRiskCents  Int           @map("at_risk_cents")
  status       FindingStatus @default(open)
  fixedAt      DateTime?     @map("fixed_at") @db.Timestamptz
  fixedBy      String?       @map("fixed_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  claim        Claim         @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([practiceId, claimId])
  @@index([practiceId, status])
  @@map("check_findings")
}

// ---------------------------------------------------------------- appeal letters (PHI, encrypted; RLS)

enum LetterStatus {
  generating // queued for the writer
  draft // written; the biller reviews and edits
  approved // the biller approved this exact version (required before PDF / sending)
  failed // the writer couldn't produce a letter (see error_code)
  superseded // replaced by a newer letter for the same claim
}

// One appeal letter. The writer (Anthropic API or ClaimHive's template) only ever sees
// de-identified content and returns text with {{PLACEHOLDERS}}; patient and practice
// details are merged in here, locally, and the result is stored encrypted.
model AppealLetter {
  id              String       @id @default(uuid()) @db.Uuid
  practiceId      String       @map("practice_id") @db.Uuid
  claimId         String       @map("claim_id") @db.Uuid
  status          LetterStatus @default(generating)
  writer          String? // "ai" | "template"
  model           String? // the model that wrote it (AI letters)
  enclosures      String[]     @default([]) // attachments sent with the appeal
  argument        String? // appeal argument kind (same values as claims.appeal_argument)
  ruleKey         String?      @map("rule_key") // the ClaimHive rule the letter used
  // Biller's extra points for the writer: checked for identifiers before anything is sent.
  notesEnc        Bytes?       @map("notes_enc")
  // The writer's de-identified text, with placeholders (kept to show what was sent/returned).
  templateEnc     Bytes?       @map("template_enc")
  // The merged letter the biller edits and approves.
  bodyEnc         Bytes?       @map("body_enc")
  recipient       String? // the insurer's appeals address (business address, not PHI)
  version         Int          @default(0)
  approvedVersion Int?         @map("approved_version")
  approvedHash    String?      @map("approved_hash") // SHA-256 of the approved text
  approvedBy      String?      @map("approved_by") @db.Uuid
  approvedAt      DateTime?    @map("approved_at") @db.Timestamptz
  sentAt          DateTime?    @map("sent_at") @db.Timestamptz
  errorCode       String?      @map("error_code")
  createdBy       String       @map("created_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  claim           Claim        @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([practiceId, claimId])
  @@index([practiceId, status])
  @@map("appeal_letters")
}

// ---------------------------------------------------------------- billing (Phase 7; PHI-free)

// Contingency rate history, append-only. practice_id NULL = ClaimHive's default rate.
// A recovery is billed at the rate in force on the date the money was recovered.
model BillingRate {
  id            String    @id @default(uuid()) @db.Uuid
  practiceId    String?   @map("practice_id") @db.Uuid
  rateBps       Int       @map("rate_bps") // basis points: 2000 = 20%
  effectiveFrom DateTime  @map("effective_from") @db.Date
  note          String?
  setBy         String    @map("set_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  practice      Practice? @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@index([practiceId, effectiveFrom])
  @@map("billing_rates")
}

enum StatementStatus {
  draft // built automatically; ClaimHive staff review it (the practice can't see it)
  issued // locked; the practice sees it and can download it
}

model Statement {
  id            String          @id @default(uuid()) @db.Uuid
  practiceId    String          @map("practice_id") @db.Uuid
  number        String?         @unique // assigned when issued, e.g. CH-202609-00012
  periodStart   DateTime        @map("period_start") @db.Date
  periodEnd     DateTime        @map("period_end") @db.Date // exclusive
  status        StatementStatus @default(draft)
  recoveredCents Int            @default(0) @map("recovered_cents") // billed recoveries on this statement
  feeCents      Int             @default(0) @map("fee_cents")
  creditCents   Int             @default(0) @map("credit_cents")
  totalCents    Int             @default(0) @map("total_cents") // fee - credit (negative = credit balance)
  issuedAt      DateTime?       @map("issued_at") @db.Timestamptz
  issuedBy      String?         @map("issued_by") @db.Uuid
  dueDate       DateTime?       @map("due_date") @db.Date
  isSynthetic   Boolean         @default(false) @map("is_synthetic")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  lines         StatementLine[]

  @@unique([practiceId, periodStart])
  @@index([status, periodStart])
  @@map("statements")
}

// One billed recovery (charge) or one reversal of a billed recovery (credit).
// Each ledger event is billed at most once, ever.
model StatementLine {
  id             String      @id @default(uuid()) @db.Uuid
  practiceId     String      @map("practice_id") @db.Uuid
  statementId    String      @map("statement_id") @db.Uuid
  kind           String // "charge" | "credit"
  resultEventId  String      @unique @map("result_event_id") @db.Uuid
  recoveredCents Int         @map("recovered_cents") // the money the fee is on
  rateBps        Int         @map("rate_bps")
  feeCents       Int         @map("fee_cents") // always positive; credits are subtracted
  occurredAt     DateTime    @map("occurred_at") @db.Date
  claimRef       String      @map("claim_ref") // ClaimHive's own claim reference, not a patient detail
  claimId        String      @map("claim_id") @db.Uuid
  payer          String
  cdtCodes       String[]    @default([]) @map("cdt_codes")
  method         String
  explanation    String // PHI-free: how the money was won (or taken back)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  statement      Statement   @relation(fields: [statementId], references: [id], onDelete: Cascade)
  resultEvent    ResultEvent @relation(fields: [resultEventId], references: [id])

  @@index([practiceId, statementId])
  @@map("statement_lines")
}
