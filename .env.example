# Local development only (synthetic data). Never commit real secrets.
MIGRATION_DATABASE_URL="postgresql://intake@localhost:5433/claimhive?host=/var/tmp/intake-pg"
DATABASE_URL="postgresql://claimhive_app@localhost:5433/claimhive?host=/var/tmp/intake-pg"
# The de-identified pool, as its own role (no access to practice data; the app role has none to the pool).
POOL_DATABASE_URL="postgresql://claimhive_pool@localhost:5433/claimhive?host=/var/tmp/intake-pg"
# base64 of 32 random bytes; dev only. Production uses AWS KMS (KEY_PROVIDER=kms).
MASTER_KEY="<base64 of 32 random bytes; dev only>"
KEY_PROVIDER="local"
APP_ENV="local"
